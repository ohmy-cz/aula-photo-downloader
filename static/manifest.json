{
  "manifest_version": 3,
  "name": "Aula Photo Downloader",
  "version_name": "alpha",
  "description": "Download Aula photos and videos for archival on your own storage, retaining or restoring capture dates.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "offscreen"
  ],
  "action": {
    "default_title": "Aula Photo Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
